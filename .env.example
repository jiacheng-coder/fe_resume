# ── 生产环境（Vercel Function）─────────────────────────
# 仅配置在 Vercel 项目环境变量中（Settings → Environment Variables），严禁提交到 git
GLM_API_KEY=

# 可选：模型名，默认 glm-4-flash（免费）；如账户有余额需更高质量可换 glm-4.6
GLM_MODEL=glm-4-flash

# ── 本地开发（直连模式，免配 vercel dev）───────────────
# 在项目根目录创建 `.env.development.local` 并写入以下变量，
# `pnpm dev` 时前端会直接请求 GLM，无需另开 vercel dev。
# 该文件已被 gitignore 排除，不会提交。
# VITE_GLM_API_KEY=你的key
